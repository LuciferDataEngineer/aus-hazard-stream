{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LuciferDataEngineer/aus-hazard-stream/contracts/quake_event.v1.json",
  "title": "QuakeEvent",
  "description": "Version 1 contract for a normalised earthquake observation from USGS or Geoscience Australia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source",
    "source_event_id",
    "origin_time",
    "updated_time",
    "latitude",
    "longitude",
    "magnitude",
    "mag_type",
    "place",
    "status",
    "event_type",
    "version",
    "ingested_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "minLength": 3 },
    "source": { "type": "string", "enum": ["usgs", "ga"] },
    "source_event_id": { "type": "string", "minLength": 1 },
    "origin_time": { "type": "string", "format": "date-time" },
    "updated_time": { "type": "string", "format": "date-time" },
    "created_time": { "type": ["string", "null"], "format": "date-time" },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "depth_km": { "type": ["number", "null"] },
    "magnitude": { "type": "number", "minimum": -2, "maximum": 10 },
    "mag_type": { "type": "string" },
    "place": { "type": "string" },
    "status": { "type": "string" },
    "event_type": { "type": "string" },
    "version": { "type": "integer" },
    "felt_reports": { "type": ["integer", "null"] },
    "url": { "type": ["string", "null"] },
    "ingested_at": { "type": "string", "format": "date-time" }
  }
}
